@startuml
autonumber
skinparam responseMessageBelowArrow true
skinparam sequenceMessageAlign center

' =============================================================
'  Login Complete Flow (Two Paths)
'   Path A: HTTP login -> WS direct connect to each backend
'   Path B: Gateway Broker two-stage connection (Recommended)
' =============================================================

actor "Client" as C
participant "Gateway:9000" as GW
participant "Broker:9001" as BR
participant "loginServer:8003" as LS
participant "chatServer:8004" as CS
participant "roomServer:8005" as RS
participant "Redis:6379" as R
database "MySQL" as DB

' Background registration (once at startup, not part of login)
note over GW,RS
  Background: Once at startup:
  loginServer registers type=login
  chatServer registers type=chat
  roomServer registers type=room
  broker registers type=broker
  Every 5s heartbeat to gateway
end note

' =============================================================
'  PATH A: HTTP login + direct WS connect
' =============================================================

== Path A: HTTP Login ==

C -> LS: POST /api/login {username, password}
activate LS
LS -> DB: SELECT * FROM users WHERE username=?
alt User exists
  DB --> LS: User{uid, bcryptPassword}
  LS -> LS: verifyPassword bcrypt.CompareHashAndPassword
  alt Password OK
    LS -> R: StoreSession SET sess token EX 24h
    R --> LS: token
    LS -> DB: SELECT * FROM user_items WHERE uid=?
    DB --> LS: items
    LS -> R: LoadInventory HSET inventory:{uid}
    LS --> C: 200 OK {code:0, token, uid, username, items}
  else Password wrong
    LS --> C: 401 errMsg=Password error
  end
else User not exists
  DB --> LS: nil
  LS --> C: 404 errMsg=User not found
end
deactivate LS

' Step A2: Client connects to each backend WS (token auto-auth)
== Path A2: Direct WS Connect ==

C -> LS: WS connect with token
activate LS
LS -> LS: Check MaxConns
LS -> LS: wsUpgrader.Upgrade
LS -> R: GetSession
R --> LS: uid username
LS -> LS: SetProperty
LS -> LS: BindUid skipRedis true
LS -> LS: ConnManager.Register
LS -> LS: wsServer.Start
LS -> C: 101 Switching Protocols
LS -> C: Push auth.ok
deactivate LS

C -> CS: WS connect with token
activate CS
CS -> CS: Same auto auth flow Push auth.ok
deactivate CS

C -> RS: WS connect with token
activate RS
RS -> RS: Same auto auth flow Push auth.ok
deactivate RS

note right of C
  Token already obtained via HTTP
  WS auto-auth binds directly
  account.login not needed
end note

' =============================================================
'  PATH B: Gateway Broker Two-Stage Connection (Recommended)
' =============================================================

== Path B: Two-Stage Connection ==

' Stage 0: HTTP login (same as Path A)
== Path B Stage 0: HTTP login ==

C -> LS: POST /api/login {username, password}
activate LS
LS -> DB: SELECT users WHERE username=?
DB --> LS: User{uid, bcrypt}
LS -> LS: verifyPassword OK
LS -> R: StoreSession SET sess token EX 24h
LS -> DB: SELECT user_items WHERE uid=?
LS -> R: LoadInventory HSET inventory
LS --> C: 200 OK token uid
deactivate LS

' Stage 1: Gateway dispatch - find a broker
== Path B Stage 1: Gateway dispatch ==

C -> GW: GET gateway dispatch uid token
activate GW
GW -> GW: Route broker RoundRobin
GW --> C: broker_url returned
deactivate GW

' Stage 2: Broker parallel dial all backends
== Path B Stage 2: Broker WS proxy ==

C -> BR: WS connect with token
activate BR

note over BR
  Broker parallel dials all 3 backends simultaneously
end note

group Channel 1: loginServer
  BR -> GW: route for login
  GW --> BR: addr loginServer
  BR -> LS: WS Upgrade with token
  LS -> R: GetSession
  R --> LS: uid username
  LS -> LS: BindUid Register Start
  LS --> BR: 101 OK
end

group Channel 2: chatServer
  BR -> GW: route for chat
  GW --> BR: addr chatServer
  BR -> CS: WS Upgrade with token
  CS -> R: GetSession
  R --> CS: uid username
  CS -> CS: BindUid Register Start
  CS --> BR: 101 OK
end

group Channel 3: roomServer
  BR -> GW: route for room
  GW --> BR: addr roomServer
  BR -> RS: WS Upgrade with token
  RS -> R: GetSession
  R --> RS: uid username
  RS -> RS: BindUid Register Start
  RS --> BR: 101 OK
end

BR -> BR: backends.Store RCU atomic replace
BR --> C: 101 Switching Protocols
BR -> C: Push auth.ok
deactivate BR

' Stage 3: WS account.login on Broker
== Path B Stage 3: WS account.login ==

C -> BR: WSReq account.login
activate BR
BR -> BR: routeByName picks nodeType login
BR -> LS: Forward WSReq
activate LS
LS -> DB: SELECT users WHERE username
DB --> LS: User uid bcrypt
LS -> LS: verifyPassword OK
LS -> LS: BindUid skipRedis false
LS -> R: SETNX lock bind uid EX 5s
LS -> R: SET online user uid nodeAddr EX 30s
LS -> R: DEL lock bind uid
R --> LS: Lock acquired
LS -> LS: Kick old conn if exists
LS -> DB: SELECT user items WHERE uid
DB --> LS: items
LS -> R: LoadInventory HSET inventory
LS -> R: StoreSession SET sess new token EX 24h
LS --> BR: WSResp account.login resp
deactivate LS
BR -> BR: Dedup check 500ms
BR -> C: BatchResp final response
deactivate BR

' Stage 4: Background heartbeat renewal
note over LS,RS
  [Background] StartHeartbeatLoop
  Pipeline SET online user uid EX 30s
  Every 10s renew, TTL 30s prevent lost
end note

' =============================================================
'  Comparison
' =============================================================

== Comparison ==

note over C,RS
  === Path A (HTTP + Direct) ===
  + Simple, good for single-node
  - Client maintains 3 WS connections
  - Connections x3 heartbeat x3 traffic x3

  === Path B (Gateway Broker) ===
  + Client maintains 1 WS only
  + Broker RCU lockless routing by message prefix
  + Auto reconnect on backend failure
  + Fan-in dedup and BatchResp merge
  - One extra hop, but Broker is very lightweight
end note

@enduml