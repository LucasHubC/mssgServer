@startuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam nodesep 60
skinparam ranksep 80

' 布局方向：自上而下，底层在最下
top to bottom direction

' ======================================
'  第一层：底层基础设施（被依赖，放最下）
' ======================================
package "⚙️  底层基础设施" as INFRA #E8F5E9 {

  package "infra/redis" {
    class RedisSession <<会话+在线>> {
      + StoreSession()
      + GetSession()
      + BindUser()
      + PublishBroadcast()
    }
    class RedisInventory <<道具原子>> {
      + AddItem()
      + ConsumeItem()
      + SaveAll()
      + LoadInventory()
    }
  }

  package "infra/rpc" {
    class RPC <<HTTP 客户端>> {
      + Register(gwURL)
      + Heartbeat(gwURL)
    }
  }

  package "infra/log" {
    class Logger {
      + Info() / Warn() / Error()
    }
  }
}

package "🗄️  数据层" as DB #FCE4EC {
  class DB <<MySQL + Redis 连接池>> {
    + DB (mssg, 300)
    + DBLog (game_log, 100)
    + RDB (Redis, 100)
  }
}

' ======================================
'  第二层：net 传输层（中间内核）
' ======================================
package "🌐  net 传输层 (内核)" as NET #E3F2FD {

  class Server <<WS 服务入口>> {
    + NewServer(addr)
    + Router(r)
    + Start()
  }

  class WSServer <<单连接>> {
    - outChan: 256
    - limiter: 30/s
    + Push()
    + Start()
    + pingLoop(30s)
  }

  class ConnManager <<全局连接表>> {
    - maxConns: 20000
    + BindUid()
    + BroadcastAll()
    + PushToUid()
    + SubscribeRemoteBroadcast()
  }

  class Router <<消息路由>>
}

' ======================================
'  第三层：业务层 + 网关层（顶层）
' ======================================

' 左边：业务 Server
package "🎮  业务 Server (login/chat/api)" as SERVER #FFF3E0 {

  package "login 模块" {
    class AccountController {
      + login() / register()
      + loginHttp() / meHttp()
    }
    class UserDAO {
      + GetByUsername()
    }
  }

  package "inventory 模块" {
    class ItemController {
      + add() / consume() / get()
      + StartAutoSave() 30s
      + Shutdown()
    }
    class ItemDAO {
      + LoadByUid() / SaveAll()
    }
    class ItemOpLogDAO {
      + InsertSafe()
      + WaitLogWrites()
    }
  }

  package "chat 模块" {
    class ChatController {
      + sendWorld()
      + sendPrivate()
      + sendGroup()
    }
  }
}

' 右边：Gateway 网关
package "🔀  Gateway 网关 (独立进程)" as GW #F3E5F5 {
  class Gateway <<路由发现+注册中心>> {
    + Register()
    + Heartbeat()
    + Route()
    + CleanupLoop()
    -- Admin --
    + HandleAdminBroadcast()
    + HandleAdminPush()
    + HandleAdminKick()
  }
  class Node {
    + IsAlive()
    + Touch()
  }
  class Route {
    + RoundRobin()
    + PickNode()
  }
}

' ======================================
'  依赖关系（从上层指向下层）
' ======================================

' ── gateway 依赖 ──
Gateway ..> RPC : 用 Request/Response
Gateway ..> RedisSession : Admin 广播 Pub/Sub
Gateway --> Node
Gateway --> Route

' ── server 业务层依赖 ──
AccountController --> RedisSession : StoreSession
AccountController --> UserDAO
ItemController --> RedisInventory : AddItem/ConsumeItem
ItemController --> ItemDAO
ItemController --> ItemOpLogDAO
ItemOpLogDAO ..> DB : 写 DBLog
ChatController ..> RedisSession : GetUserNode
ChatController ..> ConnManager : BroadcastAll

' ── server -> gateway (反向注册) ──
AccountController ..> RPC : 启动时注册
ChatController ..> RPC : 启动时注册
ItemController ..> RPC : 启动时注册

' ── net 传输层依赖 ──
Server --> Router
Server o-- WSServer
WSServer --> ConnManager
Server ..> RedisSession : token 鉴权
ConnManager ..> RedisSession : BindUser/PublishBroadcast

' ── 底层依赖 ──
Server ..> DB : Init()
AccountController ..> DB
ItemController ..> DB
DB ..> Logger
Gateway ..> Logger

' ======================================
'  布局对齐控制（hidden link 强制对齐）
' ======================================
Server -[hidden]down- DB
GW -[hidden]- SERVER

' ======================================
'  图例
' ======================================
legend bottom center
  ┌──────────────────────────────────────────────────────────┐
  │  🔵 net (内核)   🟢 infra (底层)   🟠 server (业务)      │
  │  🔴 gateway (网关)   🩷 config/DB (数据)                  │
  │                                                          │
  │  实线 = 强依赖创建    虚线 = 弱依赖/调用                   │
  │                                                          │
  │  💡 架构: 每个 Server 独立 ConnManager，跨服靠 Redis       │
  │  💡 道具修改只写 Redis(Lua)，MySQL 30s 定时落盘            │
  │  💡 WS ?token=xxx 自动鉴权                                │
  │  💡 Gateway 无业务状态，只存节点列表                        │
  └──────────────────────────────────────────────────────────┘
endlegend

@enduml